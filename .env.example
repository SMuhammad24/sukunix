# ==============================================================================
# SUKUNIX ENTERPRISE WEB & CLOUD BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas / AWS DocumentDB)
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/sukunix
# MongoDB Atlas Cloud example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sukunix?retryWrites=true&w=majority

# Official Sukunix Company Contact Details
COMPANY_NAME=Sukunix Technologies
COMPANY_EMAIL=infosukunix@gmail.com
COMPANY_PHONE=+91 8866279140
COMPANY_WHATSAPP=918866279140
WEBSITE_URL=https://sukunix.com

# Email Dispatcher Configuration (Gmail SMTP or AWS SES SMTP)
# For Gmail:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=infosukunix@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM="Sukunix Engineering" <infosukunix@gmail.com>

# For AWS SES in production (Alternative to Gmail):
# EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your_aws_ses_smtp_username
# EMAIL_PASS=your_aws_ses_smtp_password

# Automated WhatsApp & SMS Messaging Providers
# Option A: Twilio (Easiest direct server-side WhatsApp/SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=

# Option B: Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Option C: External Automation Webhook (Make.com / n8n / Zapier)
BOOKING_WEBHOOK_URL=

# CORS Settings (* for allow all, or specific domain like https://sukunix.com)
CORS_ORIGIN=*
